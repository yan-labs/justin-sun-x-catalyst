    "id": "2064683187331359161", "text": "Trust is built through action.\n\n@T3_FCU being recognized by FATF as an invaluable resource for law enforcement worldwide is an important step for a safer crypto ecosystem.", "author": {"id": "902839045356744704", "name": "H.E. Justin Sun 👨‍🚀 🌞", "screenName": "justinsuntron", "profileImageUrl": "https://pbs.twimg.com/profile_images/1954484454942298112/gmiMeJRS_normal.jpg", "verified": true}, "metrics": {"likes": 29, "retweets": 5, "replies": 22, "quotes": 1, "views": 11118, "bookmarks": 0}, "createdAt": "Wed Jun 10 12:16:46 +0000 2026", "media": [], "urls": [], "isRetweet": false, "retweetedBy": null, "lang": "en", "score": null, "isQuote": true, "isReply": false, "conversationId": "2064683187331359161", "createdAtISO": "2026-06-10T12:16:46+00:00", "createdAtLocal": "2026-06-10 20:16", "quotedTweet": {"id": "2064434163839582693", "text": "The Financial Action Task Force (@FATFNews) recognized T3 FCU as an \"invaluable resource for law enforcement agencies worldwide\" in its 2025 Asset Recovery Guidance.\n\nLearn more below.", "author": {"screenName": "T3_FCU", "name": "T3 Financial Crime Unit"}}
  },

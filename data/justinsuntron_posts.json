[{"id":"2067587173306765387","text":"Clarity brings the next wave of crypto adoption.","author":{"id":"902839045356744704","name":"H.E. Justin Sun 👨‍🚀 🌞","screenName":"justinsuntron","profileImageUrl":"https://pbs.twimg.com/profile_images/1954484454942298112/gmiMeJRS_normal.jpg","verified":true},"metrics":{"likes":41,"retweets":5,"replies":20,"quotes":0,"views":6529,"bookmarks":1},"createdAt":"Thu Jun 18 12:36:10 +0000 2026","createdAtISO":"2026-06-18T12:36:10+00:00","createdAtLocal":"2026-06-18 12:36","isRetweet":false,"retweetedBy":null,"lang":"en","score":null,"isQuote":true,"isReply":false,"conversationId":"2067587173306765387","media":[],"urls":[],"quotedTweet":{"id":"2067267424437588335","text":"The era of regulatory ambiguity in digital assets is ending. With MiCA's July 1 deadline, Brazil's new payment limits, and Africa drafting its first frameworks, 2026 is the inflection point. The jurisdictions that balance protection with innovation will shape the next decade. 👇","author":{"screenName":"AdrianWall8395","name":"Adrian Wall"}}},{"id":"2067184675211370528","text":"Protect users. Fight crime.","author":{"id":"902839045356744704","name":"H.E. Justin Sun 👨‍🚀 🌞","screenName":"justinsuntron","profileImageUrl":"https://pbs.twimg.com/profile_images/1954484454942298112/gmiMeJRS_normal.jpg","verified":true},"metrics":{"likes":62,"retweets":12,"replies":41,"quotes":1,"views":12503,"bookmarks":2},"createdAt":"Wed Jun 17 09:56:47 +0000 2026","createdAtISO":"2026-06-17T09:56:47+00:00","createdAtLocal":"2026-06-17 09:56","isRetweet":false,"retweetedBy":null,"lang":"en","score":null,"isQuote":true,"isReply":false,"conversationId":"2067184675211370528","media":[],"urls":[],"quotedTweet":{"id":"2066944674221129951","text":"Since its launch in September 2024, T3 FCU has analyzed millions of transactions globally, monitored more than $3 billion USD in total volume, and supported the freezing of over $450 million USD in illicit assets.\n\nProtect users. Fight crime. https://t.co/JF7iVCHkDm","author":{"screenName":"T3_FCU","name":"T3 Financial Crime Unit"}}},{"id":"2067140059418234889","text":"See you in HK! 🇭🇰","author":{"id":"902839045356744704","name":"H.E. Justin Sun 👨‍🚀 🌞","screenName":"justinsuntron","profileImageUrl":"https://pbs.twimg.com/profile_images/1954484454942298112/gmiMeJRS_normal.jpg","verified":true},"metrics":{"likes":170,"retweets":26,"replies":89,"quotes":2,"views":24464,"bookmarks":3},"createdAt":"Wed Jun 17 06:59:30 +0000 2026","createdAtISO":"2026-06-17T06:59:30+00:00","createdAtLocal":"2026-06-17 06:59","isRetweet":false,"retweetedBy":null,"lang":"en","score":null,"isQuote":true,"isReply":false,"conversationId":"2067140059418234889","media":[],"urls":[],"quotedTweet":{"id":"2066626805910352171","text":"BREAKING: LEGENDARY JUSTIN SUN TO SPEAK AT BITCOIN ASIA 2026 🇭🇰\n\n“I am very optimistic about the development of #Bitcoin and have great confidence in its future.” 🚀 https://t.co/xct4Qsn0d1","author":{"screenName":"Bitcoinconfasia","name":"Bitcoin Asia"}}},{"id":"2067133365606859085","text":"Keep going","author":{"id":"902839045356744704","name":"H.E. Justin Sun 👨‍🚀 🌞","screenName":"justinsuntron","profileImageUrl":"https://pbs.twimg.com/profile_images/1954484454942298112/gmiMeJRS_normal.jpg","verified":true},"metrics":{"likes":82,"retweets":7,"replies":49,"quotes":1,"views":19591,"bookmarks":0},"createdAt":"Wed Jun 17 06:32:54 +0000 2026","createdAtISO":"2026-06-17T06:32:54+00:00","createdAtLocal":"2026-06-17 06:32","isRetweet":false,"retweetedBy":null,"lang":"en","score":null,"isQuote":true,"isReply":false,"conversationId":"2067133365606859085","media":[],"urls":[],"quotedTweet":{"id":"2067072807922811178","text":"Tron Inc. (NASDAQ: TRON) acquired 156,979 TRX tokens today at an average price of $0.3185 further increasing its TRX treasury holdings to more than 700.9 million TRX in total. The company aims to further grow its Tron DAT holdings to enhance long term shareholder value. For live","author":{"screenName"